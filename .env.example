# CogniAffect BWS Annotation Platform - Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to version control.

# OpenAI API key for LLM response generation and judging
# Required for dataset_generation/generate_llm_candidate_responses.py and LLM-as-a-judge/judge.py
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# PostgreSQL database connection string
# Required for server.py to store annotations, sessions, and scenarios
# Format: postgresql://username:password@host:port/database
# For Supabase: append ?sslmode=require
# Example: postgresql://postgres:password@localhost:5432/cogniaffect
DATABASE_URL=

# Admin dashboard authentication secret
# Required for accessing /admin and uploading scenarios
# Use a strong, unique secret key (generate with: openssl rand -hex 32)
ADMIN_SECRET=

# Optional: Comma-separated list of allowed CORS origins for frontend
# Default includes GitHub Pages and common dev servers
# Example: https://yourdomain.com,https://yourapp.netlify.app
# CORS_ORIGINS=

# Optional: PostgreSQL connection pool size (default: 4)
# Increase for higher concurrent load, but respect your DB connection limits
# DB_POOL_MAX=4

# Optional: Server port (default: 5000)
# PORT=5000